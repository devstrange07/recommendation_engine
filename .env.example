OPENAI_API_KEY=sk-your-key-here
# Required when CHAT_PROVIDER=deepseek (embeddings still use OPENAI_API_KEY)
DEEPSEEK_API_KEY=
# openai | deepseek — chat + pipeline LLM; embeddings always OpenAI
CHAT_PROVIDER=openai
QDRANT_URL=http://localhost:6333
# openai: gpt-5.4-mini (default). deepseek: deepseek-v4-flash (auto if CHAT_MODEL is still gpt-*)
CHAT_MODEL=gpt-5.4-mini
# Reasoning effort for chat and pipeline chat.completions calls.
# OpenAI: used as reasoning_effort / responses reasoning.effort.
# DeepSeek: thinking is enabled by default (effort mapped to high|max).
# For internal forced-tool fallback calls, thinking is disabled automatically.
# Chat (OpenAI) also requests reasoning.summary=auto for debug-panel visibility (not full CoT).
CHAT_REASONING_EFFORT=medium
EMBEDDING_MODEL=text-embedding-3-small
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=prism
# Normalize stage concurrency (parallel LLM batch calls)
NORMALIZE_CONCURRENCY=8
# Hard cap on products per normalize LLM call
NORMALIZE_BATCH_MAX_PRODUCTS=8
# Approx token budget per batch payload (name+description+plans)
NORMALIZE_BATCH_TOKEN_BUDGET=3000
# Retries on 429 / connection / timeout before heuristic fallback
NORMALIZE_MAX_RETRIES=4
NORMALIZE_RETRY_BASE_DELAY_SECONDS=1.0
# Optional: override pipeline cost estimate rates (USD per 1M tokens)
# LLM_INPUT_USD_PER_1M=
# LLM_OUTPUT_USD_PER_1M=
# EMBEDDING_USD_PER_1M=
